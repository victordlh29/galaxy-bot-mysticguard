# ===== GALAXY BOT — EJEMPLO DE .env (sin secretos) =====
# Copia este archivo como .env para desarrollo local o usa los mismos
# nombres en el panel de justrunmy (env vars). NUNCA subas el .env real.

# --- OBLIGATORIAS (el bot NO arranca sin ellas) ---
# Token del bot (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=TU_TOKEN_DEL_BOT
# Connection string de MongoDB Atlas (Connect > Drivers)
MONGODB_URI=mongodb+srv://usuario:password@clúster.mongodb.net/mysticguard
# Cadena aleatoria que firma las cookies de sesión (mín. 10 chars)
SESSION_SECRET=cadena_aleatoria_larga_y_secreta

# --- LOGIN CON DISCORD (Developer Portal > OAuth2) ---
CLIENT_ID=TU_CLIENT_ID_DIGITOS
CLIENT_SECRET=TU_CLIENT_SECRET

# --- URLs ---
# URL pública del dashboard. Con PUBLIC_URL definida, el callback de
# OAuth se deriva automáticamente como <PUBLIC_URL>/api/auth/discord/callback
# (No hace falta DISCORD_REDIRECT_URI ni DASHBOARD_URL)
PUBLIC_URL=https://TU-APP.justrunmy.app
# DASHBOARD_URL=https://TU-APP.justrunmy.app   # fallback si no hay PUBLIC_URL
# DISCORD_REDIRECT_URI=https://TU-APP.justrunmy.app/api/auth/discord/callback  # solo si NO defines PUBLIC_URL

# --- ACCESO ---
# Tu ID de usuario de Discord (Modo desarrollador > Copiar ID de usuario).
# Te convierte en super admin al loguear con Discord.
OWNER_ID=TU_ID_DE_USUARIO_DISCORD

# --- SERVIDOR ---
# Puerto de Express (justrunmy debe exponer este puerto)
PORT=3000

# --- OPCIONALES ---
# Cookies de YouTube (contenido completo de tu cookies.txt local).
# Evita el bot-check de YouTube al reproducir música.
YT_COOKIES=# Netscape HTTP Cookie File...

# Secreto para el heartbeat de uptime (GET /api/heartbeat con x-heartbeat-secret)
# HEARTBEAT_SECRET=cadena_secreta

# Logs de depuración de música (yt-dlp/ffmpeg) — solo para resolver problemas
# DEBUG_MUSIC=true

# Timeout del pipeline de audio en ms (por defecto 60000)
# MUSIC_PIPELINE_TIMEOUT_MS=60000
